# Optional private Qwen/vLLM reranker configuration
QWEN_RERANK_ENABLED=true
QWEN_BASE_URL=http://YOUR_QWEN_HOST:8000/v1
QWEN_MODEL=qwen3.6-27b
QWEN_API_KEY=YOUR_OPTIONAL_API_KEY
QWEN_RERANK_TIMEOUT=60
QWEN_FAILURE_COOLDOWN=60

# Dense retrieval. Set false for a fast deterministic test run.
TECHJAM_ENABLE_SBERT=true
SBERT_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SBERT_BATCH_SIZE=64
