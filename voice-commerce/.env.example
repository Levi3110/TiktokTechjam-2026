# Core
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Existing OpenAI-compatible Qwen/vLLM server from ../qwen_chat.py
QWEN_MODE=local
QWEN_API_KEY=not-needed-for-local-vllm
QWEN_BASE_URL=http://172.21.25.98:8000/v1
QWEN_MODEL=qwen3.6-27b
QWEN_TIMEOUT_SECONDS=60
QWEN_MAX_TOKENS=512

# Optional persistence / AI models
MONGODB_URI=
MONGODB_DATABASE=voice_commerce
SBERT_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ENABLE_SBERT=true
MEMORY_MIN_SCORE=0.10
MEMORY_LIMIT_PER_USER=100
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional local Piper CLI. Leave blank to use browser speech / LiveTalking TTS.
PIPER_BINARY=piper
PIPER_MODEL=

# Existing LiveTalking service
LIVETALKING_URL=http://localhost:8010
